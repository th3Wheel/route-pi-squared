# .env for docker-compose.pihole.proxmox.yaml
# Copy this file to .env and fill in the values for each node.
#
# SECURITY: Never commit .env to version control.
#           Add .env to .gitignore if it is not already present.

# ── Node identity ───────────────────────────────────────────────────────────
# Static IP of THIS node (not the VIP).
# Pi-hole will bind its web interface to this address.
NODE_IP=10.20.20.11

# Hostname for the Pi-hole container
PIHOLE_HOSTNAME=pihole-1

# ── Pi-hole credentials ─────────────────────────────────────────────────────
# Web UI admin password — CHANGE THIS before deploying
PIHOLE_WEBPASSWORD=changeme

# ── Time zone ───────────────────────────────────────────────────────────────
TZ=UTC

# ── DNS upstream ────────────────────────────────────────────────────────────
# Leave as-is when using the bundled Unbound container (recommended)
PIHOLE_DNS=127.0.0.1#5335

# ── Reverse DNS (optional) ──────────────────────────────────────────────────
# Set REV_SERVER=true to enable local reverse-DNS lookups
REV_SERVER=false
REV_SERVER_DOMAIN=lan
REV_SERVER_TARGET=192.168.1.1
REV_SERVER_CIDR=192.168.1.0/24

# ── DHCP (optional) ─────────────────────────────────────────────────────────
# Enable on only one node if you want Pi-hole to serve DHCP.
# When using Keepalived HA, leave DHCP disabled on both nodes and let your
# router handle DHCP, or configure Keepalived to manage DHCP failover.
DHCP_ACTIVE=false

# ── Data directories ─────────────────────────────────────────────────────────
# Override these if you want to store data somewhere other than the defaults.
PIHOLE_DATA_DIR=/srv/pihole
UNBOUND_DATA_DIR=/srv/unbound

# ── Unbound hostname ────────────────────────────────────────────────────────
UNBOUND_HOSTNAME=unbound-1
